---
/**
 * Základní layout všech stránek: <head> se SEO, LocalBusiness schema,
 * hlavička, patička, mobilní lišta a scroll-reveal skript.
 */
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '../styles/global.css';

import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import ogImage from '../assets/photo/ARTSOME.jpeg';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  telephone: '+420739193542',
  email: site.email,
  identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: '19957751' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city.replace('-Město', ''),
    postalCode: site.address.zip.replace(' ', ''),
    addressRegion: site.address.region,
    addressCountry: 'CZ',
  },
  areaServed: site.areaServed.map((city) => ({ '@type': 'City', name: city })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.firmy.scoreNum,
    reviewCount: site.rating.firmy.count,
    bestRating: 5,
  },
  sameAs: [site.social.instagram, site.rating.firmy.url, site.rating.nejremeslnici.url],
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} is:inline />

    <!-- Označí dokument jako „JS aktivní“ ještě před vykreslením, aby se
         skryté reveal/entrance prvky neobjevily a hned neskryly (žádné bliknutí). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip-link">Přeskočit na obsah</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileStickyBar />

    <script>
      // Scroll-reveal: prvkům s třídou .reveal přidá .is-visible při vstupu
      // do viewportu. Skrývání je aktivní jen s html.js (viz global.css),
      // takže bez JS zůstává veškerý obsah viditelný.
      const revealEls = [...document.querySelectorAll<HTMLElement>('.reveal')];

      // Řízený stagger: sourozencům ve stejném rodiči přiřadíme pořadí,
      // aby seznamy (karty služeb, kroky, recenze) najížděly v sekvenci,
      // ne náhodně. Index zastropujeme, ať dlouhé seznamy nečekají.
      const groups = new Map<Element, HTMLElement[]>();
      for (const el of revealEls) {
        const parent = el.parentElement;
        if (!parent) continue;
        const list = groups.get(parent) ?? [];
        list.push(el);
        groups.set(parent, list);
      }
      for (const siblings of groups.values()) {
        if (siblings.length < 2) continue;
        siblings.forEach((el, i) => {
          el.style.setProperty('--reveal-i', String(Math.min(i, 6)));
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            // odhalit i prvky, které uživatel přeskočil (anchor odkazy,
            // rychlý scroll) — jinak by nad viewportem zůstaly neviditelné
            if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      revealEls.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -48px;
    left: 16px;
    z-index: 200;
    background: var(--blue);
    color: #fff;
    padding: .6rem 1rem;
    border-radius: 0 0 10px 10px;
    font-weight: 600;
    transition: top .2s;
  }
  .skip-link:focus { top: 0; }
</style>
