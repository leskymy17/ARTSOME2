---
/**
 * Kroky „Jak to probíhá“. Varianta `compact` (3 kroky) pro stránky služeb.
 */
import { processSteps } from '../data/process';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const steps = compact ? processSteps.filter((s) => s.short) : processSteps;
---

<ol class:list={['steps', { 'steps--compact': compact }]}>
  {steps.map((step, i) => (
    <li class="steps__item reveal">
      <span class="steps__num" aria-hidden="true">{i + 1}</span>
      <h3 class="steps__title">{step.title}</h3>
      <p class="steps__text">{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-6);
    counter-reset: step;
  }

  .steps--compact { grid-template-columns: repeat(3, 1fr); }

  .steps__item {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--blue-line);
    border-radius: var(--radius-sm);
    padding: var(--sp-6) var(--sp-4) var(--sp-4);
  }

  /* spojnice mezi kroky */
  .steps__item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 34px;
    right: -26px;
    width: 26px;
    border-top: 2px dashed var(--blue-line);
  }

  .steps__num {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 800;
    margin-bottom: var(--sp-3);
    box-shadow: 0 6px 16px -6px rgba(31, 43, 191, .55);
  }

  .steps__title { font-size: 1.02rem; margin-bottom: var(--sp-1); }
  .steps__text { font-size: .9rem; color: var(--ink-soft); }

  @media (max-width: 980px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .steps__item::after { display: none; }
  }

  @media (max-width: 560px) {
    .steps, .steps--compact { grid-template-columns: 1fr; }
  }
</style>
