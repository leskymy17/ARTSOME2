---
/**
 * Kroky „Jak to probíhá“ — kartičky s outline ikonou.
 * Vždy 3 karty vedle sebe (na homepage doplní druhý řádek).
 * Varianta `compact` (3 kroky) pro stránky služeb.
 */
import { processSteps } from '../data/process';
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const steps = compact ? processSteps.filter((s) => s.short) : processSteps;
---

<ol class:list={['steps', { 'steps--compact': compact }]}>
  {steps.map((step) => (
    <li class="steps__item reveal">
      <span class="steps__icon" aria-hidden="true"><Icon name={step.icon} size={24} /></span>
      <h3 class="steps__title">{step.title}</h3>
      <p class="steps__text">{step.text}</p>
    </li>
  ))}
</ol>

<style>
  /* Flex + wrap místo gridu: mezera mezi kartami zůstane pevných 24px
     i na širokém monitoru (grid by ji roztahoval) a neúplný poslední
     řádek (5 kroků na homepage) se sám vycentruje. */
  .steps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .steps__item {
    flex: 0 1 360px;
    max-width: 400px;
    background: var(--paper-dim);
    border-radius: var(--radius);
    padding: var(--sp-6);
  }

  /* Na stránkách služeb bílé karty (homepage zůstává na jemně šedé). */
  .steps--compact .steps__item { background: var(--paper); }

  .steps__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: var(--blue);
    color: #fff;
    margin-bottom: var(--sp-4);
  }

  .steps__title {
    font-size: 1.05rem;
    font-weight: var(--fw-bold);
    margin-bottom: var(--sp-2);
  }

  .steps__text { font-size: .92rem; color: var(--ink-soft); }

  @media (max-width: 980px) {
    .steps__item { flex-basis: calc(50% - 12px); }
  }

  @media (max-width: 560px) {
    .steps__item { flex-basis: 100%; }
  }
</style>
