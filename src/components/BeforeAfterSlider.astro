---
/**
 * Interaktivní srovnání před / po s táhlem (drag i dotyk).
 * Ovládá se nativním <input type="range"> — přístupné z klávesnice
 * a funkční i bez dalšího JS (posuvník je overlay přes celou plochu).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: { image: ImageMetadata; alt: string };
  after: { image: ImageMetadata; alt: string };
  class?: string;
}

const { before, after, class: className } = Astro.props;
const id = `ba-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['ba', className]} id={id}>
  <div class="ba__frame">
    <Image
      src={after.image}
      alt={after.alt}
      width={1100}
      widths={[640, 1100, 1600]}
      sizes="(max-width: 900px) 92vw, 1100px"
      class="ba__img"
    />
    <div class="ba__before">
      <Image
        src={before.image}
        alt={before.alt}
        width={1100}
        widths={[640, 1100, 1600]}
        sizes="(max-width: 900px) 92vw, 1100px"
        class="ba__img"
      />
    </div>
    <span class="ba__label ba__label--before" aria-hidden="true">Před</span>
    <span class="ba__label ba__label--after" aria-hidden="true">Po</span>
    <div class="ba__handle" aria-hidden="true">
      <span class="ba__handle-knob">⟨⟩</span>
    </div>
    <input
      type="range"
      class="ba__range"
      min="0"
      max="100"
      value="50"
      aria-label="Posun srovnání před a po"
    />
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.ba')) {
    const range = root.querySelector<HTMLInputElement>('.ba__range')!;
    const update = () => root.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  }
</script>

<style>
  .ba { --pos: 50%; }

  .ba__frame {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    background: var(--blue-soft);
  }

  .ba__frame :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba__label {
    position: absolute;
    top: 14px;
    z-index: 2;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: #fff;
    padding: .35rem .75rem;
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .ba__label--before { left: 14px; background: rgba(14, 18, 82, .85); }
  .ba__label--after { right: 14px; background: var(--accent); }

  .ba__handle {
    position: absolute;
    inset-block: 0;
    left: var(--pos);
    translate: -50% 0;
    width: 3px;
    background: #fff;
    z-index: 2;
    pointer-events: none;
    box-shadow: 0 0 14px rgba(0, 0, 0, .35);
  }

  .ba__handle-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--blue);
    font-weight: 700;
    letter-spacing: -1px;
    box-shadow: var(--shadow-sm);
  }

  /* Neviditelný range přes celou plochu = drag i dotyk zdarma */
  .ba__range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
  }

  .ba__range:focus-visible ~ .ba__handle .ba__handle-knob,
  .ba__frame:has(.ba__range:focus-visible) .ba__handle-knob {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
