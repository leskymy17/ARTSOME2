---
/**
 * Mobilní sticky lišta — dvě hlavní konverzní akce vždy po ruce.
 */
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="mbar" role="navigation" aria-label="Rychlý kontakt">
  <a href={site.phoneHref} class="mbar__call">
    <Icon name="phone" size={18} />
    Zavolat
  </a>
  <a href="/kontakt/" class="mbar__quote">Poptávka</a>
</div>

<style>
  .mbar {
    display: none;
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    gap: 10px;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, .92);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--blue-line);
  }

  .mbar a {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: .85rem 1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: .95rem;
  }

  .mbar__call {
    background: var(--blue-soft);
    color: var(--blue);
    border: 1.5px solid var(--blue-line);
  }

  .mbar__quote {
    background: var(--blue);
    color: #fff;
    box-shadow: 0 8px 22px -8px rgba(31, 43, 191, .7);
  }

  @media (max-width: 560px) {
    .mbar { display: flex; }
  }
</style>
