---
/**
 * Patička — zjednodušená na tři sloupce odkazů + kontakt.
 */
import { site } from '../data/site';
import { services } from '../data/services';
import Icon from './Icon.astro';
import Button from './Button.astro';
import logo from '../assets/artsome-logo-negativ.svg';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <!-- Kontaktní pás — telefon a e-mail vedle sebe -->
    <div class="footer__contact">
      <a href={site.phoneHref} class="footer__channel">
        <span class="footer__channel-icon"><Icon name="phone" size={26} /></span>
        <span class="footer__channel-body">
          <span class="footer__channel-label">Telefon</span>
          <strong class="footer__channel-value">{site.phone}</strong>
        </span>
      </a>
      <a href={`mailto:${site.email}`} class="footer__channel">
        <span class="footer__channel-icon"><Icon name="mail" size={26} /></span>
        <span class="footer__channel-body">
          <span class="footer__channel-label">E-mail</span>
          <strong class="footer__channel-value">{site.email}</strong>
        </span>
      </a>
      <div class="footer__cta">
        <Button href="/kontakt/" variant="inverse">
          Nezávazná poptávka <Icon name="send" size={18} />
        </Button>
      </div>
    </div>
  </div>

  <div class="wrap footer__grid">
    <div class="footer__brand">
      <h2 class="footer__headline">{site.tagline}.</h2>
      <p class="footer__lead">
        Rychlost, spolehlivost, kvalita, čistota a lidský přístup.
      </p>
    </div>

    <nav aria-label="Navigace v patičce">
      <h3 class="footer__head">Navigace</h3>
      <ul class="footer__list">
        <li><a href="/">Domů</a></li>
        <li><a href="/#sluzby">Služby</a></li>
        <li><a href="/reference/">Reference</a></li>
        <li><a href="/o-nas/">O nás</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
    </nav>

    <nav aria-label="Služby v patičce">
      <h3 class="footer__head">Služby</h3>
      <ul class="footer__list">
        {services.map((s) => (
          <li><a href={`/sluzby/${s.slug}/`}>{s.title}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__contact-col">
      <h3 class="footer__head">Kontakt</h3>
      <ul class="footer__list">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.address.street}</li>
        <li>{site.address.city}, {site.address.zip}</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <div class="footer__bottom-brand">
      <img src={logo.src} alt="ARTSOME" width="110" height="37" class="footer__bottom-logo" />
      <span>© {year} {site.name}</span>
    </div>
    <span>IČO: {site.ico}</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 10;
    background: var(--blue-ink);
    color: rgba(255, 255, 255, .68);
    padding: var(--sp-16) 0 var(--sp-8);
    font-size: .95rem;
  }

  /* ---- Kontaktní pás ---- */
  .footer__contact {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: var(--sp-8);
    padding-bottom: var(--sp-12);
    margin-bottom: var(--sp-12);
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .footer__cta { justify-self: end; }

  .footer__channel {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .footer__channel-icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    flex: 0 0 auto;
    border: 1.5px solid rgba(255, 255, 255, .15);
    border-radius: 50%;
    color: var(--accent-soft);
    transition: border-color .2s, background .2s;
  }

  .footer__channel:hover .footer__channel-icon {
    background: rgba(255, 255, 255, .08);
    border-color: var(--accent-soft);
  }

  .footer__channel-body { display: grid; gap: .3rem; }

  .footer__channel-label {
    font-family: var(--font-head);
    font-size: .8rem;
    font-weight: var(--fw-bold);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .footer__channel-value {
    font-family: var(--font-head);
    font-weight: var(--fw-bold);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: #fff;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .footer__channel:hover .footer__channel-value { text-decoration: underline; }

  /* ---- Hlavní mřížka ---- */
  .footer__grid {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 1fr;
    gap: var(--sp-12);
    padding-bottom: calc(var(--sp-12) + 32px);
  }

  .footer__headline {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    color: #fff;
    margin-bottom: var(--sp-3);
  }

  .footer__lead {
    max-width: 34ch;
    font-size: 1.5rem; /* 24px */
    color: rgba(255, 255, 255, .6);
  }

  .footer__head {
    font-size: .8rem;
    font-weight: var(--fw-bold);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .45);
    margin-bottom: var(--sp-4);
  }

  .footer__list { list-style: none; display: grid; gap: .6rem; }
  .footer__list a:hover { color: #fff; text-decoration: underline; }

  .footer__bottom {
    padding-top: var(--sp-6);
    border-top: 1px solid rgba(255, 255, 255, .12);
    font-size: .85rem;
    color: rgba(255, 255, 255, .5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  .footer__bottom-brand {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .footer__bottom-logo {
    height: 28px;
    width: auto;
  }

  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    .footer__contact { grid-template-columns: 1fr; gap: var(--sp-6); }
    .footer__cta { justify-self: stretch; }
    .footer__cta :global(.btn) { justify-content: center; width: 100%; }
    .footer__channel-icon { width: 58px; height: 58px; }
  }

  @media (max-width: 560px) {
    /* Dva sloupce: Navigace | Služby, claim nahoře a Kontakt dole přes celou
       šířku (dlouhý e-mail a adresa se do půl sloupce nevejdou). */
    .footer__grid { grid-template-columns: 1fr 1fr; gap: var(--sp-8) var(--sp-6); }
    .footer__contact-col { grid-column: 1 / -1; }
    /* Dolní padding pro mobilní sticky lištu (skrytá): calc(var(--sp-8) + 72px) */
  }
</style>
