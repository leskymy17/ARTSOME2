---
/**
 * Sekce recenzí. Bez `tag` zobrazí všechny (homepage),
 * s `tag` recenze k dané službě napřed + doplní ostatní do minima 12.
 * Recenze jedou jako nekonečný pás (marquee) — plynule a pomalu
 * pořád dokola, bez zastavování; pauza jen při najetí myší / fokusu.
 */
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
import starIcon from '../assets/star.svg';
import firmyBadge from '../assets/firmy-badge.webp';
import mascotPohoda from '../assets/mascot-pohoda.webp';

interface Props {
  tag?: string;
  /** Skrýt hlavičku sekce (na stránkách služeb má vlastní) */
  bare?: boolean;
}

const { tag, bare = false } = Astro.props;

// Minimum různých recenzí v pásu — bez opakování ve stejném záběru.
const MIN_ITEMS = 12;

let items = tag ? reviews.filter((r) => r.tags?.includes(tag)) : reviews;
if (tag && items.length < MIN_ITEMS) {
  // Recenze ke službě jdou první, zbytek doplní ostatní (Firmy.cz) do minima.
  const rest = reviews.filter((r) => !items.includes(r));
  items = [...items, ...rest.slice(0, MIN_ITEMS - items.length)];
}

// Pás se skládá ze dvou stejných půlek za sebou — animace posune track
// přesně o polovinu jeho šířky, takže návrat na 0 % je vizuálně nerozeznatelný
// a smyčka je nekonečná a plynulá.
// Půlka musí být vždy širší než okno prohlížeče, jinak by se vpravo objevila
// prázdná plocha (na stránkách služeb jsou jen 3 recenze). Proto se recenze
// v půlce opakují, dokud jich není aspoň MIN_ITEMS (12 karet ≈ 3800+ px,
// tedy i na 4K monitoru).
const repeats = Math.max(1, Math.ceil(MIN_ITEMS / items.length));
const half = Array.from({ length: repeats }, () => items).flat();
const track = [...half, ...half];

// Rychlost úměrná počtu karet v půlce, ať je tempo vždy stejně "pomalinku"
// bez ohledu na to, kolik je recenzí (homepage vs. stránka služby).
const duration = Math.max(half.length * 7, 28);

const initials = (name: string) => name.trim().charAt(0).toUpperCase();
---

<section class:list={['testi', { section: !bare }]} id={bare ? undefined : 'recenze'}>
  {!bare && (
    <div class="wrap testi-head reveal">
      <span class="testi-kicker">Recenze</span>
      <h2 class="testi-title">Spokojení zákazníci</h2>

      <div class="testi-rating">
        <Image
          src={firmyBadge}
          alt="Firmy.cz — TOP firma 2025"
          width={280}
          quality={100}
          class="testi-rating__badge"
        />
        <div class="testi-rating__score">
          <strong>{site.rating.firmy.score}</strong>
          <span class="testi-rating__stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <img src={starIcon.src} width="22" height="21" alt="" loading="lazy" />
            ))}
          </span>
        </div>
      </div>

      <p class="testi-rating__count">
        {site.rating.firmy.count} ověřených recenzí na <strong>Firmy.cz</strong>
      </p>
    </div>
  )}

  <div class="testi-stage reveal">
    <ul class="testi-track" style={`--testi-duration:${duration}s`} aria-label="Recenze zákazníků">
      {track.map((review, i) => (
        <li class="testi-item" aria-hidden={i >= items.length ? 'true' : undefined}>
          <blockquote class="testi-card">
            <div class="testi-stars" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <img src={starIcon.src} width="18" height="17" alt="" loading="lazy" />
              ))}
            </div>
            <p class="testi-text">„{review.text}“</p>
            <footer class="testi-who">
              <span class="testi-avatar" aria-hidden="true">{initials(review.name)}</span>
              <div>
                <cite class="testi-name">{review.name}</cite>
                <span class="testi-meta">{review.source} · {review.date}</span>
              </div>
            </footer>
          </blockquote>
        </li>
      ))}
    </ul>
  </div>

  <p class="testi-all wrap">
    <a href={site.rating.firmy.url} target="_blank" rel="noopener">
      Číst všech {site.rating.firmy.count} recenzí na Firmy.cz →
    </a>
  </p>

  <Image
    src={mascotPohoda}
    alt=""
    aria-hidden="true"
    width={1200}
    quality={100}
    class="testi-mascot"
  />
</section>

<style>
  .testi { background: var(--paper); overflow: hidden; }

  /* ---- Hlavička ---- */
  .testi-head { text-align: center; margin-bottom: var(--sp-12); }

  .testi-kicker {
    display: inline-block;
    font-family: var(--font-head);
    font-size: .8rem;
    font-weight: var(--fw-bold);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: var(--sp-3);
  }

  .testi-title {
    font-size: var(--h1);
    font-weight: var(--fw-bold);
    margin-bottom: var(--sp-4);
  }

  .testi-rating {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-6);
    margin-bottom: var(--sp-3);
  }

  .testi-rating :global(.testi-rating__badge) { width: 96px; height: auto; flex: 0 0 auto; }

  .testi-rating__score {
    display: grid;
    gap: .5rem;
    justify-items: start;
  }

  .testi-rating__score strong {
    font-family: var(--font-head);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--blue-ink);
    line-height: 1;
  }

  .testi-rating__stars { display: inline-flex; gap: .3rem; }

  .testi-rating__count {
    color: var(--ink-soft);
    font-size: .95rem;
  }

  .testi-rating__count strong {
    color: var(--ink);
    font-weight: var(--fw-bold);
  }

  /* ---- Nekonečný pás ---- */
  .testi-stage { position: relative; }

  .testi-stage::before,
  .testi-stage::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(24px, 6vw, 96px);
    z-index: 1;
    pointer-events: none;
  }

  .testi-stage::before {
    left: 0;
    background: linear-gradient(to right, var(--paper), transparent);
  }

  .testi-stage::after {
    right: 0;
    background: linear-gradient(to left, var(--paper), transparent);
  }

  .testi-track {
    list-style: none;
    display: flex;
    align-items: stretch;
    gap: 20px;
    width: max-content;
    padding-block: 4px;
    /* Mezera i za poslední kartou — půlka tracku pak měří přesně n × (karta + mezera)
       a smyčka na konci nemá 10px skok. */
    padding-right: 20px;
    animation: testi-scroll var(--testi-duration, 45s) linear infinite;
  }

  .testi-stage:hover .testi-track,
  .testi-stage:focus-within .testi-track {
    animation-play-state: paused;
  }

  @keyframes testi-scroll {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .testi-track {
      animation: none;
      overflow-x: auto;
    }
  }

  .testi-item {
    flex: 0 0 clamp(260px, 27vw, 320px);
  }

  .testi-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper-dim);
    border-radius: var(--radius);
    padding: var(--sp-8) var(--sp-6);
  }

  .testi-stars {
    display: flex;
    gap: .25rem;
    margin-bottom: var(--sp-4);
  }

  .testi-text {
    flex: 1;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: var(--sp-6);
  }

  .testi-who {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .testi-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--blue-soft);
    color: var(--blue);
    font-family: var(--font-head);
    font-weight: var(--fw-bold);
    flex: 0 0 auto;
  }

  .testi-name {
    display: block;
    font-style: normal;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: .95rem;
    color: var(--blue-ink);
  }

  .testi-meta { font-size: .82rem; color: var(--ink-soft); }

  /* ---- Odkaz na všechny recenze ---- */
  .testi-all { text-align: center; margin-top: var(--sp-8); }

  .testi-all a {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--blue);
  }

  .testi-all a:hover { text-decoration: underline; }

  .testi :global(.testi-mascot) {
    display: block;
    width: 600px;
    max-width: 100%;
    height: auto;
    margin-top: var(--sp-8);
    margin-inline: auto;
    /* mezera pod obrázkem = poloviční spodní padding sekce */
    margin-bottom: calc(var(--sp-section) / -2);
  }

  @media (max-width: 640px) {
    .testi-item { flex-basis: 78vw; }
    .testi-rating { gap: var(--sp-4); }
    .testi-rating :global(.testi-rating__badge) { width: 72px; }
    .testi-rating__score strong { font-size: 1.9rem; }
  }
</style>
