---
/**
 * FAQ akordeon — kartičky se zaobleným "+/−" přepínačem,
 * plynulé rozbalení i zabalení (grid-template-rows trik, žádný JS výpočet výšky).
 * + FAQPage schema pro vyhledávače.
 */
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
  /** Vypnout generování FAQPage schema (když je na stránce víc FAQ bloků) */
  withSchema?: boolean;
}

const { items, withSchema = true } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<div class="faq" data-faq>
  {items.map((item, i) => (
    <div class="faq__item reveal">
      <button
        type="button"
        class="faq__q"
        aria-expanded="false"
        aria-controls={`faq-a-${i}`}
        id={`faq-q-${i}`}
      >
        <span>{item.q}</span>
        <span class="faq__toggle" aria-hidden="true">
          <span class="faq__toggle-bar faq__toggle-bar--h"></span>
          <span class="faq__toggle-bar faq__toggle-bar--v"></span>
        </span>
      </button>
      <div class="faq__panel" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
        <div class="faq__panel-inner">
          <p class="faq__a">{item.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>

{withSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    for (const btn of root.querySelectorAll<HTMLButtonElement>('.faq__q')) {
      btn.addEventListener('click', () => {
        const item = btn.closest<HTMLElement>('.faq__item')!;
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        item.classList.toggle('is-open', !open);
      });
    }
  }
</script>

<style>
  .faq {
    display: grid;
    gap: var(--sp-3);
    max-width: 760px;
    margin-inline: auto;
  }

  .faq__item {
    background: var(--paper-dim);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    padding: var(--sp-6);
    background: none;
    border: 0;
    text-align: left;
    font-family: var(--font-head);
    font-weight: var(--fw-bold);
    font-size: 1.05rem;
    color: var(--blue-ink);
  }

  .faq__q:hover { color: var(--blue); }
  .faq__q:hover .faq__toggle { background: var(--blue-line); }

  .faq__toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--blue-soft);
    flex: 0 0 auto;
    transition: background var(--dur) var(--ease);
  }

  .faq__toggle-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--blue);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease);
  }

  .faq__toggle-bar--h { width: 14px; height: 2px; transform: translate(-50%, -50%); }
  .faq__toggle-bar--v { width: 2px; height: 14px; transform: translate(-50%, -50%); }

  /* Svislý pruh se schová a z "+" zůstane jen "−". */
  .faq__item.is-open .faq__toggle-bar--v { transform: translate(-50%, -50%) scaleY(0); }

  /* grid-template-rows 0fr → 1fr: plynulá výška bez JS měření a bez skoku při zavírání. */
  .faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-slow) var(--ease);
  }

  .faq__item.is-open .faq__panel { grid-template-rows: 1fr; }

  .faq__panel-inner { overflow: hidden; }

  .faq__a {
    padding: 0 var(--sp-6) var(--sp-6);
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* Mobil: o 20 % nižší karty — svislé odsazení 24 → 19,2 px (vodorovné beze změny). */
  @media (max-width: 640px) {
    .faq__q { padding-block: calc(var(--sp-6) * .8); }
    .faq__a { padding-bottom: calc(var(--sp-6) * .8); }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__panel, .faq__toggle-bar, .faq__toggle { transition: none; }
  }
</style>
