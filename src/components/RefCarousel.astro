---
/**
 * Malý karusel referencí — 4 fotky vedle sebe, šipky vpravo nahoře.
 * Posouvá se po jedné fotce, na dotykových zařízeních i swipem
 * (scroll-snap). Používá se na stránkách služeb.
 */
import { Image } from 'astro:assets';
import type { GalleryItem } from '../data/gallery';
import Icon from './Icon.astro';

interface Props {
  items: GalleryItem[];
  /** Kam vedou prokliky fotek (default /reference/) */
  href?: string;
  class?: string;
}

const { items, href = '/reference/', class: className } = Astro.props;
---

<div class:list={['refcar', className]}>
  <div class="refcar__head">
    <button class="refcar__arrow" data-refcar-prev aria-label="Předchozí fotografie" disabled>
      <Icon name="arrow-right" size={18} class="refcar__arrow-flip" />
    </button>
    <button class="refcar__arrow" data-refcar-next aria-label="Další fotografie">
      <Icon name="arrow-right" size={18} />
    </button>
  </div>

  <ul class="refcar__track" data-refcar-track aria-label="Vybrané reference">
    {items.map((item) => (
      <li class="refcar__item">
        <a href={href} class="refcar__link" aria-label={`Reference: ${item.caption}`}>
          <Image
            src={item.image}
            alt={item.alt}
            width={400}
            widths={[300, 400, 600]}
            sizes="(max-width: 640px) 70vw, (max-width: 900px) 40vw, 200px"
          />
          <span class="refcar__cap" aria-hidden="true">{item.caption}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.refcar')) {
    const track = root.querySelector<HTMLElement>('[data-refcar-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-refcar-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-refcar-next]')!;

    const step = () => {
      const item = track.querySelector<HTMLElement>('.refcar__item');
      if (!item) return 0;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item.getBoundingClientRect().width + gap;
    };

    const updateArrows = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  }
</script>

<style>
  .refcar__head {
    display: flex;
    justify-content: flex-end;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }

  .refcar__arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--blue-line);
    background: var(--paper);
    color: var(--blue);
    transition: border-color .2s, background .2s, opacity .2s;
  }

  .refcar__arrow:hover:not(:disabled) {
    border-color: var(--blue);
    background: var(--blue-soft);
  }

  .refcar__arrow:disabled {
    opacity: .35;
    cursor: default;
  }

  .refcar__arrow :global(.refcar__arrow-flip) { transform: scaleX(-1); }

  .refcar__track {
    list-style: none;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* prostor pro stín/outline při fokusu */
    padding: 2px;
    margin: -2px;
  }

  .refcar__track::-webkit-scrollbar { display: none; }

  .refcar__item {
    /* 4 fotky vedle sebe: (100 % − 3 mezery) / 4 */
    flex: 0 0 calc((100% - 3 * 14px) / 4);
    scroll-snap-align: start;
  }

  .refcar__link {
    position: relative;
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--blue-soft);
  }

  .refcar__link :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    transition: transform .45s var(--ease);
  }

  .refcar__link:hover :global(img) { transform: scale(1.05); }

  .refcar__cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.6rem .7rem .55rem;
    background: linear-gradient(transparent, rgba(10, 12, 50, .78));
    color: #fff;
    font-size: .78rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity .3s;
  }

  .refcar__link:hover .refcar__cap,
  .refcar__link:focus-visible .refcar__cap { opacity: 1; }

  @media (max-width: 900px) {
    .refcar__item { flex-basis: calc((100% - 2 * 14px) / 3); }
  }

  @media (max-width: 640px) {
    .refcar__item { flex-basis: calc((100% - 14px) / 1.6); }
    .refcar__cap { opacity: 1; }
  }
</style>
