---
/**
 * Bento galerie s filtry podle kategorie a lightboxem.
 * - filtr lze předvolit přes URL (?f=natery) — odkazy ze stránek služeb
 * - klávesnice: Enter otevře, šipky listují, Esc zavírá
 */
import { Image, getImage } from 'astro:assets';
import { gallery, galleryCategories } from '../data/gallery';
import Icon from './Icon.astro';

// Velké varianty pro lightbox předgenerujeme při buildu
const fullImages = await Promise.all(
  gallery.map((item) =>
    getImage({ src: item.image, width: 1600, format: 'webp' }),
  ),
);
---

<div class="gallery">
  <div class="gallery__filters" role="group" aria-label="Filtr referencí">
    {galleryCategories.map((cat, i) => (
      <button
        class:list={['gallery__filter', { 'is-active': i === 0 }]}
        data-filter={cat.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <div class="gallery__grid" id="galleryGrid">
    {gallery.map((item, i) => (
      <button
        class:list={['gallery__cell', item.size && `gallery__cell--${item.size}`]}
        data-category={item.category}
        data-full={fullImages[i]!.src}
        data-caption={item.caption}
        data-index={i}
        aria-label={`Zvětšit: ${item.caption}`}
      >
        <Image
          src={item.image}
          alt={item.alt}
          width={640}
          widths={[420, 640, 900]}
          sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 400px"
        />
        <span class="gallery__cap" aria-hidden="true">{item.caption}</span>
      </button>
    ))}
  </div>

  <!-- Lightbox -->
  <div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Náhled fotografie" hidden>
    <button class="lb__close" data-lb-close aria-label="Zavřít náhled">
      <Icon name="close" size={26} />
    </button>
    <button class="lb__arrow lb__arrow--prev" data-lb-prev aria-label="Předchozí fotografie">‹</button>
    <figure class="lb__figure">
      <img id="lbImage" src="" alt="" />
      <figcaption class="lb__caption">
        <span id="lbCaption"></span>
        <span id="lbCounter" class="lb__counter"></span>
      </figcaption>
    </figure>
    <button class="lb__arrow lb__arrow--next" data-lb-next aria-label="Další fotografie">›</button>
  </div>
</div>

<script>
  const grid = document.getElementById('galleryGrid');
  const cells = Array.from(grid?.querySelectorAll<HTMLElement>('.gallery__cell') ?? []);
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery__filter'));

  // ---- Filtrování ----
  function applyFilter(id: string) {
    for (const btn of filters) {
      const active = btn.dataset.filter === id;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    }
    for (const cell of cells) {
      cell.hidden = id !== 'all' && cell.dataset.category !== id;
    }
  }

  for (const btn of filters) {
    btn.addEventListener('click', () => {
      applyFilter(btn.dataset.filter!);
      const url = new URL(location.href);
      if (btn.dataset.filter === 'all') url.searchParams.delete('f');
      else url.searchParams.set('f', btn.dataset.filter!);
      history.replaceState(null, '', url);
    });
  }

  // Předvolba filtru z URL (?f=natery) — odkazy ze stránek služeb
  const preset = new URLSearchParams(location.search).get('f');
  if (preset && filters.some((b) => b.dataset.filter === preset)) applyFilter(preset);

  // ---- Lightbox ----
  const lb = document.getElementById('lightbox')!;
  const lbImage = document.getElementById('lbImage') as HTMLImageElement;
  const lbCaption = document.getElementById('lbCaption')!;
  const lbCounter = document.getElementById('lbCounter')!;
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  const visibleCells = () => cells.filter((c) => !c.hidden);

  function show(cell: HTMLElement) {
    const list = visibleCells();
    current = list.indexOf(cell);
    lbImage.src = cell.dataset.full!;
    lbImage.alt = cell.dataset.caption!;
    lbCaption.textContent = cell.dataset.caption!;
    lbCounter.textContent = `${current + 1} / ${list.length}`;
  }

  function open(cell: HTMLElement) {
    lastFocused = cell;
    show(cell);
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    (lb.querySelector('[data-lb-close]') as HTMLElement).focus();
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  function step(dir: 1 | -1) {
    const list = visibleCells();
    const next = list[(current + dir + list.length) % list.length];
    if (next) show(next);
  }

  for (const cell of cells) cell.addEventListener('click', () => open(cell));

  lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => step(-1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => step(1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>

<style>
  /* ---- Filtry ---- */
  .gallery__filters {
    display: flex;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-8);
  }

  .gallery__filter {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: .95rem;
    color: var(--blue-ink);
    background: var(--paper);
    border: 1.5px solid var(--blue-line);
    border-radius: var(--radius-pill);
    padding: .6rem 1.3rem;
    transition: all .2s var(--ease);
  }

  .gallery__filter:hover { border-color: var(--blue); color: var(--blue); }

  .gallery__filter.is-active {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  /* ---- Bento grid ---- */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 210px;
    grid-auto-flow: dense;
    gap: 14px;
  }

  .gallery__cell {
    position: relative;
    border: 0;
    padding: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--blue-soft);
  }

  .gallery__cell--wide { grid-column: span 2; }
  .gallery__cell--tall { grid-row: span 2; }

  .gallery__cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .45s var(--ease);
  }

  .gallery__cell:hover :global(img) { transform: scale(1.05); }

  .gallery__cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2rem .9rem .7rem;
    background: linear-gradient(transparent, rgba(10, 12, 50, .78));
    color: #fff;
    font-size: .85rem;
    font-weight: 600;
    text-align: left;
    opacity: 0;
    transition: opacity .3s;
  }

  .gallery__cell:hover .gallery__cap,
  .gallery__cell:focus-visible .gallery__cap { opacity: 1; }

  /* ---- Lightbox ---- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(8, 10, 40, .92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-8);
  }

  /* author styl s display:flex by jinak přebil UA pravidlo pro [hidden] */
  .lb[hidden] { display: none; }

  .lb__figure {
    max-width: min(1200px, 92vw);
    max-height: 86vh;
    display: flex;
    flex-direction: column;
  }

  .lb__figure img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lb__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    color: rgba(255, 255, 255, .85);
    font-size: .92rem;
    padding-top: var(--sp-3);
  }

  .lb__counter { color: rgba(255, 255, 255, .55); }

  .lb__close {
    position: absolute;
    top: 18px;
    right: 22px;
    background: none;
    border: 0;
    color: #fff;
    opacity: .8;
  }
  .lb__close:hover { opacity: 1; }

  .lb__arrow {
    background: rgba(255, 255, 255, .1);
    border: 1px solid rgba(255, 255, 255, .25);
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    flex: 0 0 auto;
    transition: background .2s;
  }
  .lb__arrow:hover { background: rgba(255, 255, 255, .22); }
  .lb__arrow--prev { margin-right: var(--sp-4); }
  .lb__arrow--next { margin-left: var(--sp-4); }

  @media (max-width: 900px) {
    .gallery__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; }
  }

  @media (max-width: 560px) {
    .gallery__grid { grid-template-columns: 1fr; grid-auto-rows: 230px; }
    .gallery__cell--wide { grid-column: auto; }
    .gallery__cell--tall { grid-row: auto; }
    .gallery__cap { opacity: 1; } /* na dotykových zařízeních popisek rovnou */
    .lb { padding: var(--sp-2); }
    .lb__arrow {
      position: fixed;
      bottom: 20px;
      z-index: 1;
    }
    .lb__arrow--prev { left: 20%; }
    .lb__arrow--next { right: 20%; }
  }
</style>
