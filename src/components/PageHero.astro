---
/**
 * Modré hero podstránek — drobečky + H1 + perex (slot).
 * Volitelně `mascot`: postavička po pas, ukotvená v pravé části hero
 * (jen dekorace, text se před ní zalamuje).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  crumbs: { label: string; href?: string }[];
  mascot?: ImageMetadata;
}

const { title, crumbs, mascot } = Astro.props;
---

<section class:list={['phero', { 'phero--mascot': Boolean(mascot) }]}>
  {mascot && (
    <Image
      src={mascot}
      alt=""
      aria-hidden="true"
      width={mascot.width}
      widths={[360, 540, 896]}
      sizes="(max-width: 640px) 0px, 30vw"
      quality={95}
      class="phero__mascot"
    />
  )}
  <div class="wrap">
    <Breadcrumbs items={crumbs} onDark />
    <h1 class="phero__title">{title}</h1>
    {Astro.slots.has('default') && (
      <p class="phero__lead"><slot /></p>
    )}
  </div>
</section>

<style>
  .phero {
    /* šířka postavičky (jen s mascot); výška = šířka × 1,339 (poměr 896 : 1200) */
    --pm-w: clamp(190px, 28vw, 430px);
    position: relative;
    background: linear-gradient(160deg, var(--blue) 60%, var(--blue-deep));
    color: #fff;
    padding-block: var(--sp-12) var(--sp-16);
    overflow: hidden;
  }

  .phero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(100% 80% at 90% 0%, rgba(255, 255, 255, .1), transparent 55%);
    pointer-events: none;
  }

  .phero .wrap { position: relative; z-index: 1; }

  .phero__title {
    font-size: var(--h1);
    font-weight: var(--fw-bold);
    color: #fff;
    margin-block: var(--sp-4);
  }

  .phero__lead {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, .86);
    max-width: 60ch;
  }

  /* ---- Postavička po pas v pravé části ---- */
  .phero :global(.phero__mascot) {
    /* Výška postavičky: podle šířky okna (max --pm-w × 1,339), ale nikdy víc, než
       aby hlava ležela aspoň 20 px pod horní hranou hero. Pas (opasek) je asi
       61 % výšky obrázku od shora, proto (výška hero − 20 px) / 0,61. */
    --h0: min(calc(var(--pm-w) * 1.339), calc((100% - 20px) / .61));
    position: absolute;
    z-index: 0;
    /* zarovnáno k pravému okraji obsahu (.wrap má max. šířku a boční padding 24 px) */
    right: calc(max(0px, (100vw - var(--max)) / 2) + 24px);
    /* Postavička o 15 % větší než základ --h0. Základní poloha (pas na spodní
       hraně hero) je top = 100 % − 0,61 × --h0; posun je teď −16 px (výš než
       základ). Spodek obrázku přesahuje pod hero (overflow: hidden ho ořízne). */
    height: calc(var(--h0) * 1.15);
    width: auto;
    top: calc(100% - var(--h0) * .61 - 16px);
    pointer-events: none;
    user-select: none;
  }

  /* Text se před postavičkou zalamuje; horní polovina obrázku vlevo je prázdná
     (levá ruka končí u ~19 % šířky), proto rezervujeme jen ~80 % její šířky
     (šířka je teď až 1,15 × --pm-w). */
  .phero--mascot .phero__title,
  .phero--mascot .phero__lead {
    max-width: calc(100% - var(--pm-w) * 1.15 * .8 - 16px);
  }
  .phero--mascot .phero__lead { max-width: min(60ch, calc(100% - var(--pm-w) * 1.15 * .8 - 16px)); }

  /* Na telefonech je místa na šířku málo — postavička se skrývá. */
  @media (max-width: 640px) {
    .phero :global(.phero__mascot) { display: none; }
    .phero--mascot .phero__title,
    .phero--mascot .phero__lead { max-width: none; }
  }
</style>
