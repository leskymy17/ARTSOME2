---
/**
 * Hero (V2) — full-bleed sekce s prolínajícími se fotkami na pozadí
 * a pomalým Ken Burns zoomem. Obsah je přeuspořádaný: nahoře eyebrow +
 * Firmy.cz badge, dole velký nadpis, CTA a napravo hodnocení + perex.
 */
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Icon from './Icon.astro';
import Button from './Button.astro';
import RatingStars from './RatingStars.astro';

import badge from '../assets/firmy-badge.webp';
import mascotEdge from '../assets/artsome-maskot-okraj.webp';
import bg1 from '../assets/photo/chata-hero.webp';
import bg2 from '../assets/photo/artsome-hala-rekonstrukce.webp';
import bg3 from '../assets/photo/natery/natery-15.webp';
import bg4 from '../assets/photo/hero-artsome.webp';

const slides = [
  { img: bg1, alt: 'Dřevěná chata po kompletní renovaci nátěru' },
  { img: bg2, alt: 'Hala po kompletní rekonstrukci' },
  { img: bg3, alt: 'Hotový nátěr plechové střechy' },
  { img: bg4, alt: 'Firemní vozidla ARTSOME polepená logem' },
];
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    {slides.map((s, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide>
        <Image
          src={s.img}
          alt=""
          width={1920}
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </div>
    ))}
    <div class="hero__scrim"></div>
  </div>

  {slides.length > 1 && (
    <div class="hero__dots" aria-hidden="true">
      {slides.map((_, i) => (
        <span class:list={['hero__dot', { 'is-active': i === 0 }]} data-dot></span>
      ))}
    </div>
  )}

  <!-- Maskot vykukující z pravého spodního rohu; výška = 65 % výšky hero, takže se
       s hero sekcí (a tím se zařízením) zmenšuje. Pod obsahem (text ho překrývá). -->
  <Image
    src={mascotEdge}
    alt=""
    aria-hidden="true"
    width={636}
    widths={[318, 636]}
    quality={95}
    loading="eager"
    class="hero__mascot"
  />

  <div class="wrap hero__inner">
    <div class="hero__bottom">
      <h1 class="hero__title">
        Malířství, nátěry a <em>renovace</em> bez kompromisů
      </h1>

      <div class="hero__row">
        <div class="hero__actions">
          <Button href={site.phoneHref} variant="inverse">
            <Icon name="phone" /> {site.phone}
          </Button>
          <Button href="/kontakt/" variant="light">
            <span class="hero__lbl-full">Cenová kalkulace zdarma</span>
            <span class="hero__lbl-short">Poptávka</span>
          </Button>
        </div>

        <div class="hero__aside">
          <a href={site.rating.firmy.url} target="_blank" rel="noopener" class="hero__badge" aria-label="Firmy.cz — TOP firma 2025, hodnocení firmy">
            <Image src={badge} alt="Firmy.cz — TOP firma 2025" width={280} />
          </a>
          <a href={site.rating.firmy.url} target="_blank" rel="noopener" class="hero__rating">
            <RatingStars />
            <strong>{site.rating.firmy.score} na Firmy.cz</strong>
            <span>{site.rating.firmy.count} recenzí</span>
          </a>
          <p class="hero__lead">
            Vymalujeme pokoj i celý objekt. Rychle, čistě a za rozumnou cenu —
            od první barvy po závěrečný úklid.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const slides = [...document.querySelectorAll<HTMLElement>('.hero__slide')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];

  if (slides.length > 1 && !reduceMotion) {
    let cur = 0;

    // První snímek je aktivní už ze serveru — zoom spustíme až po prvním
    // snímku, aby přechod transformace opravdu naběhl (ne skokem).
    requestAnimationFrame(() => slides[0].classList.add('is-zooming'));

    setInterval(() => {
      const next = (cur + 1) % slides.length;
      slides[next].classList.add('is-active', 'is-zooming');
      slides[cur].classList.remove('is-active');
      dots[next]?.classList.add('is-active');
      dots[cur]?.classList.remove('is-active');
      // zoom u odcházejícího snímku resetujeme až po prolnutí (skryté).
      const leaving = slides[cur];
      setTimeout(() => leaving.classList.remove('is-zooming'), 1600);
      cur = next;
    }, 5000);
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    --hero-h: min(920px, 88svh);
    /* výška maskota jako podíl výšky hero (desktop 65 %, menší na tablet/mobil) */
    --mascot-k: .65;
    /* šířka maskota = výška × poměr stran obrázku (636 : 1200) */
    --mascot-w: calc(var(--hero-h) * var(--mascot-k) * .53);
    min-height: var(--hero-h);
    color: #fff;
    overflow: hidden;
    background: var(--blue-ink);
  }

  /* ---- Pozadí: prolínající se fotky + Ken Burns ---- */
  .hero__bg { position: absolute; inset: 0; z-index: 0; }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .hero__slide.is-active { opacity: 1; }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 6.5s ease-out;
    will-change: transform;
  }
  .hero__slide.is-zooming :global(img) { transform: scale(1.09); }

  /* Scrim pro čitelnost bílého textu — silnější dole (nadpis, CTA). */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(9, 12, 45, .70) 0%, rgba(9, 12, 45, .30) 55%, rgba(9, 12, 45, .10) 100%),
      linear-gradient(0deg, rgba(9, 12, 45, .80) 0%, rgba(9, 12, 45, .25) 42%, rgba(9, 12, 45, .35) 100%);
  }

  /* ---- Indikátor snímků ---- */
  .hero__dots {
    position: absolute;
    z-index: 1;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, .4);
    transition: width var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .hero__dot.is-active {
    width: 26px;
    background: #fff;
  }

  /* ---- Maskot v pravém spodním rohu ---- */
  .hero :global(.hero__mascot) {
    position: absolute;
    /* Mírný přesah za okraj hero (overflow: hidden ho ořízne): při naklánění
       by se jinak u pravého a spodního okraje objevila škvíra s pozadím. */
    right: calc(var(--hero-h) * var(--mascot-k) * -.02);
    bottom: calc(var(--hero-h) * var(--mascot-k) * -.015);
    z-index: 1;
    height: calc(var(--mascot-k) * 100%);
    width: auto;
    pointer-events: none;
    user-select: none;
    /* Naklánění kolem bodu v ~60 % výšky: horní část (hlava, ruka s štětcem) se
       kývá, ale nevyjede z rámu tak daleko jako při otáčení kolem paty. */
    transform-origin: 50% 60%;
    animation: hero-mascot-wave 4s ease-in-out infinite;
    will-change: transform;
  }

  /* Cyklus 4 s, decentní: doleva (−1,5°), přes střed doprava (+1,5°), zpět
     a pauza (~2,5 s do dalšího zakývání). ease-in-out mezi každými dvěma
     klíči = plynulé, bez trhání. */
  @keyframes hero-mascot-wave {
    0%    { transform: rotate(0deg); }
    10%   { transform: rotate(-1.5deg); }
    22.5% { transform: rotate(1.5deg); }
    35%   { transform: rotate(0deg); }
    100%  { transform: rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__mascot) { animation: none; }
  }

  /* ---- Obsah ---- */
  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: var(--sp-8) calc(var(--sp-12) + 72px);
  }

  .hero__badge {
    width: fit-content;
    transition: transform var(--dur) var(--ease);
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, .35));
  }
  .hero__badge:hover { transform: scale(1.05); }
  .hero__badge :global(img) { width: clamp(63px, 6.75vw, 99px); height: auto; }

  /* ---- Dolní blok ---- */
  .hero__bottom { margin-top: auto; }

  .hero__title {
    font-size: clamp(2.6rem, 6.4vw, 5.1rem);
    font-weight: var(--fw-bold);
    line-height: 1.02;
    letter-spacing: -.025em;
    color: #fff;
    max-width: 15ch;               /* drží nadpis v bloku, ne přes celou šířku */
    text-wrap: balance;
    margin-bottom: var(--sp-8);
    text-shadow: 0 2px 40px rgba(0, 0, 0, .35);
  }
  .hero__title em { font-style: normal; color: #fff; }

  .hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-8);
    flex-wrap: wrap;
  }

  .hero__actions {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  /* Hero CTA jsou o ~30 % větší než výchozí tlačítka. */
  .hero__actions :global(.btn) {
    font-size: 1.27rem;
    padding: 1.18rem 2rem;
  }
  .hero__actions :global(.btn svg) { width: 23px; height: 23px; }

  /* Krátký popisek „Poptávka“ jen na mobilu (viz @media níže). */
  .hero__lbl-short { display: none; }

  .hero__aside {
    max-width: 42ch;
    display: grid;
    gap: var(--sp-3);
  }

  /* Desktop: pravý blok (hodnocení + perex) uhne maskotovi z rohu. Odsazení =
     šířka maskota − vzdálenost obsahu od okraje okna + 16 px rezerva; řádek se
     nezalamuje, blok se raději zúží (perex se zalomí do víc řádků). */
  @media (min-width: 861px) {
    .hero__row { flex-wrap: nowrap; }
    .hero__aside {
      flex: 0 1 42ch;
      min-width: 220px;
      margin-right: max(0px, calc(var(--mascot-w) - max(0px, (100vw - var(--max)) / 2) - 24px + 16px));
    }
  }

  .hero__rating {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-size: .95rem;
    color: rgba(255, 255, 255, .9);
  }
  .hero__rating strong { color: #fff; font-family: var(--font-head); }
  .hero__rating:hover strong { text-decoration: underline; }

  .hero__lead {
    font-size: 1.06rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, .9);
    text-shadow: 0 1px 20px rgba(0, 0, 0, .3);
  }

  @media (max-width: 860px) {
    .hero { min-height: min(760px, 90svh); }
    .hero__inner { padding-block: var(--sp-8) 40px; }
    .hero__row { flex-direction: column; align-items: stretch; gap: var(--sp-6); }
    .hero__aside { max-width: none; }
    /* Obě tlačítka vedle sebe: menší písmo a odsazení, žádné zalamování. */
    .hero__actions { flex-wrap: nowrap; gap: 10px; }
    .hero__actions :global(.btn) {
      flex: 1 1 auto;
      justify-content: center;
      min-width: 0;
      font-size: 1rem;
      padding: 1rem .9rem;
    }
    .hero__actions :global(.btn svg) { width: 18px; height: 18px; }
    .hero__lbl-full { display: none; }
    .hero__lbl-short { display: inline; }
    .hero__badge, .hero__lead { display: none; }

    /* Tablet a mobil: obsah zabírá celou šířku, maskot proto menší (38 % výšky
       místo 65 %), ať nezakrývá nadpis a tlačítka. */
    .hero { --mascot-k: .38; }
  }

  @media (max-width: 560px) {
    /* Na mobilu se maskot v rohu skrývá (velikost --mascot-k zůstává pro návrat). */
    .hero { --mascot-k: .35; }
    .hero :global(.hero__mascot) { display: none; }
  }

  @media (max-width: 360px) {
    .hero__actions :global(.btn) { font-size: .9rem; padding-inline: .7rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide :global(img) { transition: none; }
    .hero__slide.is-zooming :global(img) { transform: scale(1); }
  }
</style>
