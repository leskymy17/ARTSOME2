---
/**
 * Karta služby — používá se v mřížce na homepage.
 * Celá karta je klikatelná a vede na detail služby.
 * Fotka přes celou kartu + tmavě modrý gradient zespodu pro čitelnost bílého textu.
 */
import { Image } from 'astro:assets';
import type { Service } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="svc reveal">
  <div class="svc__img">
    <Image
      src={service.image}
      alt={service.imageAlt}
      width={480}
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 280px"
    />
    <div class="svc__scrim" aria-hidden="true"></div>
  </div>
  <div class="svc__body">
    <h3 class="svc__title">
      <a href={`/sluzby/${service.slug}/`} class="svc__link-cover">{service.title}</a>
    </h3>
    <span class="svc__more">
      Více o službě <Icon name="arrow-right" size={15} />
    </span>
  </div>
</article>

<style>
  .svc {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 340px;
    isolation: isolate;
    transition:
      transform .35s var(--ease),
      box-shadow .35s var(--ease);
  }

  .svc:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }

  .svc__img {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .svc__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s var(--ease);
  }

  .svc:hover .svc__img :global(img) { transform: scale(1.07); }

  .svc__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--blue-ink) 0%,
      rgba(14, 18, 82, .88) 22%,
      rgba(14, 18, 82, .45) 48%,
      rgba(14, 18, 82, 0) 75%
    );
  }

  .svc__body {
    position: relative;
    margin-top: auto;
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .svc__title {
    font-size: var(--h2);
    font-weight: 700;
    color: #fff;
  }

  /* Klikatelná celá karta bez zanoření interaktivních prvků */
  .svc__link-cover::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .svc__more {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: .9rem;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }

  .svc__more :global(svg) { transition: transform .25s var(--ease); }
  .svc:hover .svc__more :global(svg) { transform: translateX(4px); }
</style>
