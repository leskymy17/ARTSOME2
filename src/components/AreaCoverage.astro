---
/**
 * Oblast působení — lokální SEO sekce s výčtem měst.
 * Vlevo obrázek (default mapa kraje), vpravo text + města.
 * Props `image` + `imageAlt` nahradí mapu fotkou (zaoblená, oříznutá do rámu),
 * `background` přebije výchozí pozadí sekce.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import mapaKraje from '../assets/mapa-artsome.webp';

interface Props {
  image?: ImageMetadata;
  imageAlt?: string;
  background?: string;
}

const {
  image,
  imageAlt = 'Mapa Moravskoslezského kraje s okresy Bruntál, Opava, Nový Jičín, Karviná, Ostrava-město a Frýdek-Místek',
  background,
} = Astro.props;

const isPhoto = Boolean(image);
const src = image ?? mapaKraje;
---

<section class="area section" id="oblast" style={background ? `background:${background}` : undefined}>
  <div class="wrap area__inner">
    <div class="area__text">
      <SectionHead kicker="Kde působíme" title="Dojedeme kamkoliv v MS kraji" class="reveal">
        Sídlíme v Havířově a za prací vyjíždíme po celém kraji.
        Cestu máme v ceně — žádné příplatky za dopravu v regionu.
      </SectionHead>

      <ul class="area__list reveal">
        {site.areaServed.map((city) => (
          <li class="area__city">
            <Icon name="map-pin" size={16} />
            {city}
          </li>
        ))}
        <li class="area__city area__city--more">a další města v kraji</li>
      </ul>
    </div>

    <div class:list={['area__map', 'reveal', { 'area__map--photo': isPhoto }]}>
      <Image
        src={src}
        alt={imageAlt}
        width={src.width}
        widths={[640, 960, 1280, 1820]}
        sizes="(max-width: 900px) min(92vw, 480px), 680px"
        quality={95}
      />
    </div>
  </div>
</section>

<style>
  .area { background: var(--blue-soft); }

  .area__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--sp-12);
  }

  .area__text :global(.sec-head) { margin-bottom: var(--sp-8); }

  .area__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--sp-3);
    max-width: 560px;
  }

  .area__city {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    background: var(--paper);
    border: 1px solid var(--blue-line);
    border-radius: var(--radius-pill);
    padding: .55rem 1.1rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: .92rem;
    color: var(--blue-ink);
  }

  .area__city :global(svg) { color: var(--blue); }

  .area__city--more {
    background: transparent;
    border-style: dashed;
    color: var(--ink-soft);
    font-weight: 500;
  }

  /* Mapa vlevo, text vpravo — v DOM zůstává text první (čtečky, mobil). */
  .area__map { order: -1; justify-self: start; width: 100%; max-width: 640px; }
  .area__map :global(img) { width: 100%; height: auto; display: block; }

  /* Fotka místo mapy: vyplní celý sloupec, zaoblený rámeček, ořez na pevný poměr. */
  .area__map--photo { max-width: none; }
  .area__map--photo :global(img) {
    aspect-ratio: 1.1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (max-width: 900px) {
    .area__inner { grid-template-columns: 1fr; gap: var(--sp-8); }
    .area__map { order: 0; justify-self: center; max-width: 480px; }
  }
</style>
