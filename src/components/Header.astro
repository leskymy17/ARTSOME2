---
/**
 * Hlavička webu — sticky, s rozbalovacím menu Služby a mobilní navigací.
 */
import { site } from '../data/site';
import { services } from '../data/services';
import Icon from './Icon.astro';
import Button from './Button.astro';
import logo from '../assets/artsome-logo.svg';

const { pathname } = Astro.url;
const isActive = (path: string) =>
  path === '/' ? pathname === '/' : pathname.startsWith(path);
---

<header class="header">
  <div class="wrap header__row">
    <a href="/" class="header__logo" aria-label="ARTSOME — úvodní stránka">
      <img src={logo.src} alt="ARTSOME — malířství a natěračství" width="140" height="47" />
    </a>

    <nav class="header__nav" aria-label="Hlavní navigace">
      <ul class="header__menu">
        <li class="header__item header__item--has-sub">
          <a
            href="/#sluzby"
            class:list={['header__link', { 'is-active': isActive('/sluzby') }]}
            aria-haspopup="true"
          >
            Služby <Icon name="chevron-down" size={14} />
          </a>
          <ul class="header__sub">
            {services.map((s) => (
              <li>
                <a href={`/sluzby/${s.slug}/`} class="header__sub-link">{s.title}</a>
              </li>
            ))}
          </ul>
        </li>
        <li><a href="/reference/" class:list={['header__link', { 'is-active': isActive('/reference') }]}>Reference</a></li>
        <li><a href="/o-nas/" class:list={['header__link', { 'is-active': isActive('/o-nas') }]}>O nás</a></li>
        <li><a href="/kontakt/" class:list={['header__link', { 'is-active': isActive('/kontakt') }]}>Kontakt</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <a href={site.phoneHref} class="header__phone">
        <Icon name="phone" size={18} />
        <strong>{site.phone}</strong>
      </a>
      <Button href="/kontakt/" class="header__cta">
        <span class="header__cta-full">Nezávazná poptávka</span>
        <span class="header__cta-short">Poptávka</span>
        <Icon name="send" size={16} />
      </Button>
      <button
        class="header__burger"
        id="navToggle"
        aria-expanded="false"
        aria-controls="mobileNav"
        aria-label="Otevřít menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobilní menu -->
  <nav class="header__mobile" id="mobileNav" aria-label="Mobilní navigace" hidden>
    <ul>
      <li class="header__mobile-group">Služby</li>
      {services.map((s) => (
        <li><a href={`/sluzby/${s.slug}/`}>{s.title}</a></li>
      ))}
      <li class="header__mobile-sep" role="presentation"></li>
      <li><a href="/reference/">Reference</a></li>
      <li><a href="/o-nas/">O nás</a></li>
      <li><a href="/kontakt/">Kontakt</a></li>
    </ul>
    <a href={site.phoneHref} class="header__mobile-phone">
      <Icon name="phone" size={18} /> {site.phone}
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mobileNav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Otevřít menu' : 'Zavřít menu');
    if (nav) nav.hidden = open;
    document.body.classList.toggle('nav-open', !open);
  });

  // Povýšení hlavičky po odscrollování (jemný stín) + skrytí při scrollu
  // dolů a plynulý návrat při scrollu nahoru.
  const header = document.querySelector('.header');
  let lastY = window.scrollY;
  let ticking = false;

  const updateHeader = () => {
    const y = window.scrollY;
    header?.classList.toggle('is-scrolled', y > 8);

    const mobileOpen = document.body.classList.contains('nav-open');
    if (!mobileOpen) {
      header?.classList.toggle('is-hidden', y > lastY && y > 120);
    }

    lastY = y;
    ticking = false;
  };

  updateHeader();
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    },
    { passive: true },
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--blue-line);
    transition:
      box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur-slow) var(--ease);
  }
  /* Po odscrollování hlavička jemně „vzlétne“ nad obsah. */
  .header.is-scrolled {
    box-shadow: 0 6px 24px -14px rgba(20, 28, 120, .5);
    border-bottom-color: transparent;
  }
  /* Scroll dolů ji plynule schová, scroll nahoru zase vrátí. */
  .header.is-hidden { transform: translateY(-100%); }

  /* 3 sloupce místo flexu se space-between: menu je pak vždy přesně
     uprostřed lišty, ne jen "v prostoru mezi" logem a akcemi. */
  .header__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-6);
    height: 76px;
  }

  .header__logo { justify-self: start; }

  .header__logo img { height: 56px; width: auto; }

  .header__menu {
    display: flex;
    gap: var(--sp-8);
    list-style: none;
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-weight: 500;
    color: var(--ink);
    padding-block: .5rem;
    transition: color var(--dur) var(--ease);
  }
  /* Podtržení najíždí zleva místo skokového rámečku. */
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--blue);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .header__link:hover { color: var(--blue); }
  .header__link:hover::after { transform: scaleX(1); }
  .header__link.is-active { color: var(--blue); }
  .header__link.is-active::after { transform: scaleX(1); }

  /* Rozbalovací submenu Služby */
  .header__item--has-sub { position: relative; }
  .header__sub {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    translate: -50% 0;
    min-width: 210px;
    background: var(--paper);
    border: 1px solid var(--blue-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    list-style: none;
    padding: .5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity .2s var(--ease), transform .2s var(--ease), visibility .2s;
  }
  .header__item--has-sub:hover .header__sub,
  .header__item--has-sub:focus-within .header__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .header__sub-link {
    display: block;
    padding: .55rem .8rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: .95rem;
  }
  .header__sub-link:hover { background: var(--blue-soft); color: var(--blue); }

  .header__actions { display: flex; align-items: center; justify-self: end; gap: var(--sp-6); }

  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: var(--blue-ink);
    font-family: var(--font-head);
  }
  .header__phone:hover { color: var(--blue); }

  /* Krátký popisek tlačítka se ukazuje jen na mobilu (viz @media níže). */
  .header__cta-short { display: none; }

  /* Burger */
  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 8px;
  }
  .header__burger span {
    width: 24px;
    height: 2.5px;
    background: var(--blue-ink);
    border-radius: 2px;
    transition: transform .25s var(--ease), opacity .2s;
  }
  .header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  /* Mobilní menu */
  .header__mobile {
    background: var(--paper);
    border-bottom: 1px solid var(--blue-line);
    padding: var(--sp-4) 24px var(--sp-6);
  }
  .header__mobile ul { list-style: none; }
  .header__mobile a {
    display: block;
    padding: .7rem 0;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--blue-ink);
  }
  .header__mobile-group {
    font-size: .78rem;
    font-weight: var(--fw-bold);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-block: .5rem;
  }
  .header__mobile-sep { border-top: 1px solid var(--blue-line); margin-block: .5rem; }
  .header__mobile-phone {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-top: var(--sp-4);
    color: var(--blue);
    font-weight: var(--fw-bold);
    font-family: var(--font-head);
  }

  @media (max-width: 960px) {
    .header__nav, .header__phone { display: none; }
    .header__burger { display: flex; }
    /* Dva sloupce (logo | akce). Původní 3 sloupce nechávaly logu jen 1fr
       a stlačily ho; akce jsou teď doprava, hamburger úplně vpravo. */
    .header__row {
      grid-template-columns: auto 1fr;
      height: 64px;
    }
    /* Logo ≈ 20 % šířky lišty (poměr 317:151 → výška ≈ 43px při 20vw = 90px). */
    .header__logo img { width: 20vw; min-width: 84px; height: auto; }
    .header__actions { gap: var(--sp-2); justify-self: end; }
    /* Prefix .header__actions zvedá specifičnost nad scoped .btn z Button.astro,
       jinak by se tyhle přepisy vůbec neuplatnily. */
    .header__actions :global(.header__cta) { padding: .65rem 1.1rem; font-size: .9rem; }
    /* Na mobilu jen krátké „Poptávka“ — s větším logem se delší text nevejde. */
    .header__cta-full { display: none; }
    .header__cta-short { display: inline; }
  }
</style>
