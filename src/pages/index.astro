---
/**
 * Homepage — nese hlavní příběh: hero → důvěra → služby → proces
 * → ukázka práce → recenze → o nás → oblast → FAQ → poptávka.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ReferenceCarousel from '../components/ReferenceCarousel.astro';
import AreaCoverage from '../components/AreaCoverage.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

import { site } from '../data/site';
import { services } from '../data/services';
import { gallery, caseStudy } from '../data/gallery';
import { faq } from '../data/faq';
import mascotPoptavka from '../assets/mascot-poptavka.webp';

// "Renovace chaty — detail vchodu" je skoro identický záběr jako
// "Renovace chaty — Beskydy" (stejná chata, stejný úhel) — v teaseru
// vedle sebe vypadaly jako duplicita, tak ho vyřazujeme.
const withoutDuplicate = gallery.filter((item) => item.caption !== 'Renovace chaty — detail vchodu');
const teaser = [
  withoutDuplicate[1]!, // Výmalba — akcentní stěna
  withoutDuplicate[0]!, // Renovace chaty — Beskydy
  withoutDuplicate[4]!, // Rekonstrukce sklepa — po
  withoutDuplicate[2]!, // Fototapeta a výmalba
  withoutDuplicate[3]!, // Výmalba pokoje — modrá stěna
  withoutDuplicate[5]!, // Rekonstrukce sklepa — před
  ...withoutDuplicate.slice(6, 10),
];
---

<BaseLayout
  title="ARTSOME — Malířství, nátěry a renovace | Moravskoslezský kraj"
  description={site.description}
>
  <Hero />
  <TrustStrip />

  <!-- SLUŽBY -->
  <section class="section section--dim" id="sluzby">
    <div class="wrap">
      <SectionHead kicker="Co pro vás uděláme" title="Čtyři věci, které umíme nejlépe" center class="reveal">
        Od jednoho pokoje po kompletní rekonstrukci. Interiér i exteriér, dřevo i kov.
      </SectionHead>

      <div class="home-svc-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

      <p class="home-svc-note reveal">
        Lepíme také <strong>tapety a fototapety</strong>, děláme <strong>dekorativní stěrky</strong>
        a zajišťujeme drobné zednické práce — štuky, perlinku i nové jádro.
      </p>
    </div>
  </section>

  <!-- JAK TO PROBÍHÁ -->
  <section class="section" id="postup">
    <div class="wrap">
      <SectionHead kicker="Jak to probíhá" title="Od poptávky po úklid v pěti krocích" center class="reveal">
        Žádné překvapení — dopředu víte, co se bude dít, kdy a za kolik.
      </SectionHead>
      <ProcessSteps />
    </div>
  </section>

  <!-- REFERENCE TEASER + PROMĚNA -->
  <section class="section home-ref" id="reference">
    <div class="wrap">
      <div class="home-ref-head reveal">
        <SectionHead kicker="Reference" title="Naše práce mluví za nás" onDark class="home-ref-title">
          Reálné fotky z realizací po celém kraji — žádný stock, jen odvedená práce.
        </SectionHead>
        <Button href="/reference/" variant="inverse" class="home-ref-btn">
          Všechny reference <Icon name="arrow-right" size={16} />
        </Button>
      </div>

      <ReferenceCarousel items={teaser} class="home-ref-carousel reveal" />

      <div class="home-case reveal">
        <div class="home-case__text">
          <SectionHead kicker={caseStudy.kicker} title={caseStudy.title}>
            {caseStudy.text}
          </SectionHead>
          <Button href="/reference/" variant="primary">
            Celá proměna v referencích <Icon name="arrow-right" size={16} />
          </Button>
        </div>
        <BeforeAfterSlider
          before={caseStudy.pairs[0]!.before}
          after={caseStudy.pairs[0]!.after}
          class="home-case__slider"
        />
      </div>
    </div>
  </section>

  <ReviewsSection />
  <AreaCoverage />

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap">
      <SectionHead kicker="Časté dotazy" title="Na co se nás ptáte nejčastěji" center class="reveal" />
      <FaqAccordion items={faq} />
    </div>
  </section>

  <!-- POPTÁVKA -->
  <section class="home-contact" id="poptavka">
    <div class="wrap home-contact__grid">
      <div class="home-contact__info reveal">
        <SectionHead
          kicker="Nezávazná poptávka"
          title="Domluvíme schůzku a kalkulaci zdarma"
          onDark
        >
          Napište nebo zavolejte — ozveme se obvykle do 24 hodin
          a vypracujeme nezávaznou cenovou nabídku.
        </SectionHead>
        <div class="home-contact__channels">
          <a href={site.phoneHref} class="home-contact__channel">
            <Icon name="phone" /> {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="home-contact__channel">
            <Icon name="mail" /> {site.email}
          </a>
        </div>

        <Image
          src={mascotPoptavka}
          alt=""
          aria-hidden="true"
          width={760}
          quality={100}
          class="home-contact__mascot"
        />
      </div>
      <div class="home-contact__form reveal">
        <LeadForm source="homepage" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Služby ---- */
  .home-svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .home-svc-note {
    text-align: center;
    margin-top: var(--sp-8);
    color: var(--ink-soft);
    font-size: .96rem;
  }

  .home-svc-note strong { color: var(--blue-ink); }

  /* ---- Reference teaser ---- */
  .home-ref { background: var(--blue-ink); }

  .home-ref-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-8);
    flex-wrap: wrap;
  }

  .home-ref-head :global(.home-ref-title) { margin-bottom: var(--sp-8); }
  :global(.home-ref-btn) { margin-bottom: var(--sp-8); }

  :global(.home-ref-carousel) { margin-bottom: var(--sp-16); }

  /* ---- Případovka ---- */
  .home-case {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: var(--sp-12);
    align-items: center;
    background: var(--paper);
    border: 1px solid var(--blue-line);
    border-radius: var(--radius);
    padding: var(--sp-12);
  }

  .home-case__text :global(.sec-head) { margin-bottom: var(--sp-6); }

  /* ---- Poptávka ---- */
  .home-contact {
    position: relative;
    background: linear-gradient(160deg, var(--blue) 55%, var(--blue-deep));
    padding-block: var(--sp-section);
  }

  .home-contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    /* stretch (ne start): sloupec s textem tak sahá přes celou výšku
       řádku, i když je vlastní obsah kratší — díky tomu se dá maskot
       spolehlivě zarovnat k jeho pravému a spodnímu okraji. */
    align-items: stretch;
  }

  .home-contact__info { position: relative; }

  /* Maskot zarovnaný k pravému okraji textového sloupce (u paty
     formuláře) — dole záměrně přesahuje přes patu sekce, aby ho
     dole "uřízla" navazující patička. */
  .home-contact__info :global(.home-contact__mascot) {
    display: block;
    position: absolute;
    right: 0;
    /* -sp-section (spodní odsazení sekce) + kus navíc: teprve tak se
       spodek maskota dostane za hranu sekce a schová se pod patičku. */
    bottom: calc(-1 * var(--sp-section) - 8px);
    width: clamp(219px, 20vw, 352px);
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  .home-contact__channels {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  .home-contact__channel {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    width: fit-content;
    background: rgba(14, 18, 82, .35);
    border-radius: var(--radius-pill);
    padding: 1rem 1.75rem;
    color: #fff;
    font-family: var(--font-head);
    font-weight: var(--fw-bold);
    font-size: 1.15rem;
    transition: background var(--dur) var(--ease);
  }

  .home-contact__channel:hover { background: rgba(14, 18, 82, .5); }

  .home-contact__form {
    background: var(--paper);
    border-radius: var(--radius);
    padding: var(--sp-8);
    box-shadow: var(--shadow);
  }

  /* ---- Responzivita ---- */
  @media (max-width: 1000px) {
    .home-svc-grid { grid-template-columns: repeat(2, 1fr); }
    .home-case { grid-template-columns: 1fr; padding: var(--sp-6); gap: var(--sp-6); }
    .home-contact__grid { grid-template-columns: 1fr; gap: var(--sp-8); }
    /* Ve sloupci by maskot přesahoval do formuláře pod ním — na mobilu skryjeme. */
    .home-contact__info :global(.home-contact__mascot) { display: none; }
  }

  @media (max-width: 640px) {
    .home-svc-grid { grid-template-columns: 1fr; }
  }
</style>
