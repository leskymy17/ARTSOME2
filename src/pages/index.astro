---
/**
 * Homepage — nese hlavní příběh: hero → důvěra → služby → proces
 * → ukázka práce → recenze → o nás → oblast → FAQ → poptávka.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ReferenceCarousel from '../components/ReferenceCarousel.astro';
import AreaCoverage from '../components/AreaCoverage.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

import { site } from '../data/site';
import { services } from '../data/services';
import { gallery, caseStudy } from '../data/gallery';
import { faq } from '../data/faq';
import mascotPoptavka from '../assets/mascot-poptavka.webp';
import artsomeAuto from '../assets/artsome-auto.webp';
import refBackground from '../assets/artsome-background.webp';

// "Renovace chaty — detail vchodu" je skoro identický záběr jako
// "Renovace chaty — Beskydy" (stejná chata, stejný úhel) — v teaseru
// vedle sebe vypadaly jako duplicita, tak ho vyřazujeme.
const withoutDuplicate = gallery.filter((item) => item.caption !== 'Renovace chaty — detail vchodu');
const teaser = [
  withoutDuplicate[1]!, // Výmalba — akcentní stěna
  withoutDuplicate[0]!, // Renovace chaty — Beskydy
  withoutDuplicate[4]!, // Rekonstrukce sklepa — po
  withoutDuplicate[2]!, // Fototapeta a výmalba
  withoutDuplicate[3]!, // Výmalba pokoje — modrá stěna
  withoutDuplicate[5]!, // Rekonstrukce sklepa — před
  ...withoutDuplicate.slice(6, 10),
];
---

<BaseLayout
  title="ARTSOME — Malířství, nátěry a renovace | Moravskoslezský kraj"
  description={site.description}
>
  <Hero />
  <TrustStrip />

  <!-- SLUŽBY -->
  <section class="section section--dim" id="sluzby">
    <div class="wrap">
      <SectionHead kicker="Co pro vás uděláme" title="Čtyři věci, které umíme nejlépe" center class="reveal">
        Od jednoho pokoje po kompletní rekonstrukci. Interiér i exteriér, dřevo i kov.
      </SectionHead>

      <div class="home-svc-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

      <p class="home-svc-note reveal">
        Lepíme také <strong>tapety a fototapety</strong>, děláme <strong>dekorativní stěrky</strong>
        a zajišťujeme drobné zednické práce — štuky, perlinku i nové jádro.
      </p>
    </div>
  </section>

  <!-- JAK TO PROBÍHÁ -->
  <section class="section" id="postup">
    <div class="wrap">
      <SectionHead kicker="Jak to probíhá" title="Od poptávky po úklid ve čtyřech krocích" center class="reveal">
        Žádné překvapení — dopředu víte, co se bude dít, kdy a za kolik.
      </SectionHead>
      <ProcessSteps />
    </div>
  </section>

  <!-- REFERENCE TEASER + PROMĚNA -->
  <section class="section home-ref" id="reference" style={`--ref-bg: url("${refBackground.src}")`}>
    <div class="wrap">
      <div class="home-ref-head reveal">
        <SectionHead kicker="Reference" title="Naše práce mluví za nás" onDark class="home-ref-title">
          Reálné fotky z realizací po celém kraji — žádný stock, jen odvedená práce.
        </SectionHead>
        <Button href="/reference/" variant="inverse" class="home-ref-btn">
          Všechny reference <Icon name="arrow-right" size={16} />
        </Button>
      </div>

      <ReferenceCarousel items={teaser} class="home-ref-carousel reveal" />

      {/* PROMĚNA PŘED/PO — dočasně skryto. Pro návrat odstraň tento komentář;
          komponenta BeforeAfterSlider, data (caseStudy) i styly .home-case zůstávají.

      <div class="home-case reveal">
        <div class="home-case__text">
          <SectionHead kicker={caseStudy.kicker} title={caseStudy.title}>
            {caseStudy.text}
          </SectionHead>
          <Button href="/reference/" variant="primary">
            Celá proměna v referencích <Icon name="arrow-right" size={16} />
          </Button>
        </div>
        <BeforeAfterSlider
          before={caseStudy.pairs[0]!.before}
          after={caseStudy.pairs[0]!.after}
          class="home-case__slider"
        />
      </div>
      */}
    </div>
  </section>

  <ReviewsSection />
  <AreaCoverage
    image={artsomeAuto}
    imageAlt="Firemní vozidla ARTSOME s logem firmy zaparkovaná před domem"
    background="#fbfbfb"
  />

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap">
      <SectionHead kicker="Časté dotazy" title="Na co se nás ptáte nejčastěji" center class="reveal" />
      <FaqAccordion items={faq} />
    </div>
  </section>

  <!-- POPTÁVKA -->
  <section class="home-contact" id="poptavka">
    <div class="wrap home-contact__grid">
      <div class="home-contact__info reveal">
        <SectionHead
          kicker="Nezávazná poptávka"
          title="Domluvíme schůzku a kalkulaci zdarma"
          onDark
        >
          Napište nebo zavolejte — ozveme se obvykle do 24 hodin
          a vypracujeme nezávaznou cenovou nabídku.
        </SectionHead>
        <Image
          src={mascotPoptavka}
          alt=""
          aria-hidden="true"
          width={760}
          quality={100}
          class="home-contact__mascot"
        />
      </div>
      <div class="home-contact__form reveal">
        <LeadForm source="homepage" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Služby ---- */
  .home-svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .home-svc-note {
    text-align: center;
    margin-top: var(--sp-8);
    color: var(--ink-soft);
    font-size: .96rem;
  }

  .home-svc-note strong { color: var(--blue-ink); }

  /* ---- Reference teaser ---- */
  /* Fotka (tmavě modrá strukturovaná stěna) místo jednobarevného pozadí;
     původní barva zůstává jako záloha, než se obrázek načte. */
  .home-ref {
    background: var(--blue-ink) var(--ref-bg) center / cover no-repeat;
  }

  .home-ref-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-8);
    flex-wrap: wrap;
  }

  .home-ref-head :global(.home-ref-title) { margin-bottom: var(--sp-8); }
  :global(.home-ref-btn) { margin-bottom: var(--sp-8); }

  /* Full-bleed: fotky sahají až k okraji okna, i když komponenta sedí
     uvnitř .wrap (funguje, protože .wrap je v prohlížeči vycentrovaný). */
  :global(.home-ref-carousel) {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: var(--sp-16);
  }

  /* ---- Případovka ---- */
  .home-case {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: var(--sp-12);
    align-items: center;
    background: var(--paper);
    border: 1px solid var(--blue-line);
    border-radius: var(--radius);
    padding: var(--sp-12);
  }

  .home-case__text :global(.sec-head) { margin-bottom: var(--sp-6); }

  /* ---- Poptávka ---- */
  .home-contact {
    position: relative;
    background: linear-gradient(160deg, var(--blue) 55%, var(--blue-deep));
    padding-block: var(--sp-section);
    /* Maskot dole přesahuje přes patu sekce — clip ho na hraně sekce uřízne. */
    overflow: clip;
  }

  .home-contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    /* start: sloupec s textem (a maskotem pod ním) je vyšší než formulář,
       formulář se proto nemá natahovat na jeho výšku. */
    align-items: start;
  }

  /* Sloupec s textem sahá přes celou výšku řádku (i když je formulář vyšší) —
     maskot s margin-top: auto tak vždy sedí u spodní hrany řádku. */
  .home-contact__info {
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: stretch;
  }

  /* Maskot uprostřed pod celým textovým blokem (nadpis, perex, kontakty).
     Dole záměrně přesahuje přes patu sekce o 8 px: záporný spodní margin
     = spodní odsazení sekce + 8 px, overflow: clip na sekci ho tam uřízne.
     Velikost +15 % oproti původním clamp(219px, 20vw, 352px). */
  .home-contact__info :global(.home-contact__mascot) {
    display: block;
    margin: auto auto calc(-1 * var(--sp-section) - 8px);
    width: clamp(252px, 23vw, 405px);
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  .home-contact__form {
    background: var(--paper);
    border-radius: var(--radius);
    padding: var(--sp-8);
    box-shadow: var(--shadow);
  }

  /* Mobil: užší boční odsazení uvnitř boxu formuláře (32 → 20 px). */
  @media (max-width: 640px) {
    .home-contact__form { padding-inline: 20px; }
  }

  /* ---- Responzivita ---- */
  @media (max-width: 1000px) {
    .home-svc-grid { grid-template-columns: repeat(2, 1fr); }
    .home-case { grid-template-columns: 1fr; padding: var(--sp-6); gap: var(--sp-6); }
    .home-contact__grid { grid-template-columns: 1fr; gap: var(--sp-8); }
    /* Ve sloupci by maskot přesahoval do formuláře pod ním — na mobilu skryjeme. */
    .home-contact__info :global(.home-contact__mascot) { display: none; }
  }

  @media (max-width: 640px) {
    .home-svc-grid { grid-template-columns: 1fr; }
  }
</style>
